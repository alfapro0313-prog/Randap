generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(cuid())
  deviceKey String        @unique
  name      String
  handle    String        @unique
  avatar    String?
  points    Int           @default(0)
  createdAt DateTime      @default(now())
  videos    Video[]
  comments  Comment[]
  subs      Subscription[] @relation("SubscribedChannels")
}

model Video {
  id            String    @id @default(cuid())
  title         String
  description   String?
  thumbPath     String
  videoPath     String
  hash          String    @unique
  kind          String    @default("video")
  durationSec   Int       @default(0)
  allowComments Boolean   @default(true)
  views         Int       @default(0)
  uploaderId    String
  uploader      User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         Like[]
  createdAt     DateTime  @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  deviceId  String
  createdAt DateTime @default(now())

  @@unique([videoId, deviceId])
}

model Subscription {
  id        String   @id @default(cuid())
  channelId String
  channel   User     @relation("SubscribedChannels", fields: [channelId], references: [id], onDelete: Cascade)
  deviceId  String
  createdAt DateTime @default(now())

  @@unique([channelId, deviceId])
}

model Subject {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String        @default("book")
  color       String        @default("emerald")
  order       Int           @default(0)
  lessons     Lesson[]
  quizzes     Quiz[]
}

model Lesson {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  summary     String
  content     String
  durationMin Int     @default(5)
  order       Int     @default(0)
}

model Quiz {
  id          String        @id @default(cuid())
  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int           @default(0)
  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id           String  @id @default(cuid())
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text         String
  options      String
  correctIndex Int
  order        Int     @default(0)
}

model QuizAttempt {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  deviceId     String
  score        Int
  total        Int
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())
}
