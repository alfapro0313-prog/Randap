generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  deviceKey String      @unique
  name      String
  handle    String      @unique
  createdAt DateTime    @default(now())
  videos    Video[]
  comments  Comment[]
}

model Video {
  id            String    @id @default(cuid())
  title         String
  description   String?
  thumbPath     String
  videoPath     String
  hash          String    @unique
  kind          String    @default("video")
  durationSec   Int       @default(0)
  allowComments Boolean   @default(true)
  views         Int       @default(0)
  uploaderId    String
  uploader      User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         Like[]
  createdAt     DateTime  @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  deviceId  String
  createdAt DateTime @default(now())

  @@unique([videoId, deviceId])
}

model Subscription {
  id        String   @id @default(cuid())
  channelId String
  deviceId  String
  createdAt DateTime @default(now())

  @@unique([channelId, deviceId])
}
